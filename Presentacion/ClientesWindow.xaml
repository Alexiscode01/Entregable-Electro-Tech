<Window x:Class="Presentacion.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Solutions – Clientes" Height="580" Width="780"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblModo" Text="Nuevo cliente" Style="{StaticResource Titulo}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="DNI / RUC:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtDocumento" Grid.Row="0" Grid.Column="1" MaxLength="11"/>
            <TextBlock Grid.Row="1" Text="Nombre:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" MaxLength="100"/>
            <TextBlock Grid.Row="2" Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtTelefono" Grid.Row="2" Grid.Column="1" MaxLength="15"/>
            <TextBlock Grid.Row="3" Text="Correo:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtEmail" Grid.Row="3" Grid.Column="1" MaxLength="100"/>
            <StackPanel Grid.Column="2" Grid.RowSpan="4" Margin="8,0,0,0">
                <Button x:Name="btnGuardar" Content="Guardar" Click="btnGuardar_Click"/>
                <Button x:Name="btnNuevo" Content="Nuevo" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Buscar (DNI/RUC o nombre):" Style="{StaticResource Etiqueta}" DockPanel.Dock="Left"/>
            <Button x:Name="btnBuscar" Content="Buscar" DockPanel.Dock="Right" Click="btnBuscar_Click"/>
            <TextBox x:Name="txtBuscar"/>
        </DockPanel>

        <DataGrid x:Name="dgClientes" Grid.Row="3" Margin="4,8,4,4" AutoGenerateColumns="False"
                  SelectionChanged="dgClientes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DNI / RUC" Binding="{Binding Documento, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono, Mode=OneWay}" Width="110"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Email, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
