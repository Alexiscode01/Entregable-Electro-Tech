<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proyecto de inicio: interfaz gráfica en WPF (.NET Framework 4.8).
       Abrir con Visual Studio 2022 o superior (carga de trabajo "Desarrollo de escritorio de .NET"). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Presentacion</RootNamespace>
    <AssemblyName>TechSolutions</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Tech Solutions</AssemblyTitle>
    <Product>Tech Solutions</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>TSicono.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="TSicono.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Printing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entidades\Entidades.csproj" />
    <ProjectReference Include="..\Negocio\Negocio.csproj" />
    <ProjectReference Include="..\Utilidades\Utilidades.csproj" />
  </ItemGroup>

</Project>
