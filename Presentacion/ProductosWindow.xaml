<Window x:Class="Presentacion.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Solutions – Productos y stock" Height="620" Width="800"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblModo" Text="Nuevo producto" Style="{StaticResource Titulo}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Código:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCodigo" Grid.Row="0" Grid.Column="1" MaxLength="20"/>
            <TextBlock Grid.Row="1" Text="Nombre:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" MaxLength="100"/>
            <TextBlock Grid.Row="2" Text="Categoría:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCategoria" Grid.Row="2" Grid.Column="1" MaxLength="50"/>
            <TextBlock Grid.Row="3" Text="Precio (S/):" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtPrecio" Grid.Row="3" Grid.Column="1" MaxLength="12" HorizontalAlignment="Left" Width="140"/>
            <TextBlock Grid.Row="4" Text="Stock:" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtStock" Grid.Row="4" Grid.Column="1" MaxLength="7" HorizontalAlignment="Left" Width="140"/>
            <StackPanel Grid.Column="2" Grid.RowSpan="5" Margin="8,0,0,0">
                <Button x:Name="btnGuardar" Content="Guardar" Click="btnGuardar_Click"/>
                <Button x:Name="btnNuevo" Content="Nuevo" Click="btnNuevo_Click"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Buscar (código, nombre o categoría):" Style="{StaticResource Etiqueta}" DockPanel.Dock="Left"/>
            <Button x:Name="btnBuscar" Content="Buscar" DockPanel.Dock="Right" Click="btnBuscar_Click"/>
            <TextBox x:Name="txtBuscar"/>
        </DockPanel>

        <DataGrid x:Name="dgProductos" Grid.Row="3" Margin="4,8,4,4" AutoGenerateColumns="False"
                  SelectionChanged="dgProductos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="Precio (S/)" Binding="{Binding Precio, Mode=OneWay, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock, Mode=OneWay}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
