<Window x:Class="Presentacion.ReportesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Solutions – Reportes" Height="720" Width="940"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Parámetros del reporte de ventas -->
        <StackPanel x:Name="panelParametros" Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Desde:" Style="{StaticResource Etiqueta}"/>
            <DatePicker x:Name="dpDesde" Width="120"/>
            <TextBlock Text="Hasta:" Style="{StaticResource Etiqueta}"/>
            <DatePicker x:Name="dpHasta" Width="120"/>
            <TextBlock Text="Vendedor:" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboVendedor" Width="150" DisplayMemberPath="Login" SelectedValuePath="Id"/>
            <Button x:Name="btnGenerar" Content="Generar" FontWeight="Bold" Click="btnGenerar_Click"/>
        </StackPanel>

        <ProgressBar x:Name="pbCarga" Grid.Row="1" Height="6" Margin="4,4,4,6"
                     IsIndeterminate="True" Visibility="Hidden"/>

        <TabControl x:Name="tabReportes" Grid.Row="2">
            <!-- Ventas -->
            <TabItem x:Name="tabVentas" Header="Ventas">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgVentas" Grid.Row="0" AutoGenerateColumns="True"
                              AutoGeneratingColumn="Columna_AutoGenerating"
                              SelectionChanged="dgVentas_SelectionChanged"/>
                    <DockPanel Grid.Row="1" Margin="0,4,0,0">
                        <Button x:Name="btnAnular" Content="Anular venta" DockPanel.Dock="Right" Click="btnAnular_Click"/>
                        <TextBlock x:Name="lblResumen" FontWeight="Bold" TextWrapping="Wrap"
                                   Style="{StaticResource Etiqueta}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="Productos de la venta seleccionada" Style="{StaticResource Etiqueta}"/>
                    <DataGrid x:Name="dgDetalle" Grid.Row="3" AutoGenerateColumns="True"
                              AutoGeneratingColumn="Columna_AutoGenerating"/>
                </Grid>
            </TabItem>

            <!-- Productos más vendidos -->
            <TabItem x:Name="tabTop" Header="Productos más vendidos">
                <DataGrid x:Name="dgTop" AutoGenerateColumns="True" Margin="6"
                          AutoGeneratingColumn="Columna_AutoGenerating"/>
            </TabItem>

            <!-- Stock bajo -->
            <TabItem x:Name="tabStock" Header="Stock bajo">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Stock igual o menor a:" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtMinimo" Width="70" MaxLength="6"/>
                        <Button x:Name="btnStockBajo" Content="Consultar" Click="btnStockBajo_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="dgStock" Grid.Row="1" AutoGenerateColumns="True"
                              AutoGeneratingColumn="Columna_AutoGenerating"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btnImprimir" Content="Imprimir / Vista previa" Click="btnImprimir_Click"/>
            <Button x:Name="btnExportar" Content="Exportar CSV" Click="btnExportar_Click"/>
            <Button x:Name="btnCerrar" Content="Cerrar" Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
