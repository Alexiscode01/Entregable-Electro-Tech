<Window x:Class="Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tech Solutions" Height="480" Width="820" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="mnuClientes" Header="_Clientes" Click="mnuClientes_Click"/>
            <MenuItem x:Name="mnuProductos" Header="_Productos / Stock" Click="mnuProductos_Click"/>
            <MenuItem x:Name="mnuVentas" Header="_Ventas" Click="mnuVentas_Click"/>
            <MenuItem x:Name="mnuReportes" Header="_Reportes" Click="mnuReportes_Click"/>
            <MenuItem x:Name="mnuUsuarios" Header="_Usuarios" Click="mnuUsuarios_Click"/>
            <MenuItem x:Name="mnuCerrarSesion" Header="Cerrar _sesión" Click="mnuCerrarSesion_Click"/>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="lblSesion"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="lblAlerta" Foreground="DarkOrange" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="lblReloj"/>
            </StatusBarItem>
        </StatusBar>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="TECH SOLUTIONS" FontSize="36" FontWeight="Bold"
                       Foreground="{StaticResource ColorPrimario}" HorizontalAlignment="Center"/>
            <TextBlock Text="Gestión de clientes, productos y ventas" FontSize="15" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,4,0,24"/>
            <TextBlock x:Name="lblBienvenida" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
        </StackPanel>
    </DockPanel>
</Window>
