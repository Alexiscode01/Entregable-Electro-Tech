<?xml version="1.0" encoding="utf-8" ?>
<!-- Configuración de Tech Solutions (la lee el Singleton Datos.Configuracion).
     Data Source según tu servidor:  .\SQLEXPRESS (SQL Server Express)  ·  . o (local) (Developer)  ·  (localdb)\MSSQLLocalDB -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="TechSolutions"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=TechSolutions;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Minutos sin usar mouse ni teclado antes de cerrar la sesión automáticamente -->
    <add key="MinutosInactividad" value="5" />
    <!-- Se avisa en la barra de estado cuando un producto llega a este stock o menos -->
    <add key="UmbralStockBajo" value="5" />
    <!-- true: el Administrador solo puede entrar desde un equipo autorizado (autenticación por hardware) -->
    <add key="AutenticacionHardware" value="true" />
  </appSettings>
</configuration>
